# Provider is picked automatically: Groq if GROQ_API_KEY is set, else Gemini.

# Groq (recommended — fast free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Groq retires models often; list yours with GET https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b        # must accept images
# GROQ_VISION_FALLBACK_MODELS=
# GROQ_REASONING_EFFORT=low                 # low | medium | high, or empty to omit

# Gemini (alternative): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# LLM_PROVIDER=groq                # force a provider
# LLM_ATTEMPT_TIMEOUT_MS=25000     # per model, before trying the next one
# LLM_TIMEOUT_MS=50000             # whole request
# PORT=8787

# Set to 1 to return canned responses without calling any API (no key needed).
# MOCK_LLM=1
