# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-flash-latest
# Tried in order if the main model is overloaded (503), rate-limited, or slow.
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# GEMINI_ATTEMPT_TIMEOUT_MS=25000   # per model, before moving to the next
# GEMINI_TIMEOUT_MS=50000           # whole request
# GEMINI_LOW_THINKING=1             # set 0 if a model rejects thinkingConfig
# PORT=8787

# Set to 1 to return a canned recipe without calling Gemini (no key needed).
# MOCK_LLM=1
